# Copie para .env apenas no ambiente local. Nunca versione o .env.
COMPOSE_PROJECT_NAME=video-ai-platform
APP_ENV=development
LOG_LEVEL=info

# Portas locais
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
API_PORT=8080
WEB_PORT=3000

# Banco de dados (troque todos os valores fora do ambiente local)
POSTGRES_DB=video_ai
POSTGRES_USER=video_ai
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://video_ai:change-me-local-only@postgres:5432/video_ai

# Redis
REDIS_PASSWORD=change-me-local-only
REDIS_URL=redis://:change-me-local-only@redis:6379/0

# Armazenamento S3 compatível (no Compose, API e worker usam MINIO_ROOT_* como credenciais S3)
MINIO_ROOT_USER=change-me-local-only
MINIO_ROOT_PASSWORD=change-me-local-only
S3_ENDPOINT=http://minio:9000
# Host usado nas URLs assinadas entregues ao navegador
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=video-ai-local
S3_ACCESS_KEY=change-me-local-only
S3_SECRET_KEY=change-me-local-only
S3_FORCE_PATH_STYLE=true

# Segurança e retenção
APP_SECRET=change-me-with-at-least-32-random-characters
# Assina os cookies de sessão; se vazio, o Compose usa APP_SECRET
JWT_SECRET=change-me-with-at-least-32-random-characters
JWT_TTL_MINUTES=720
COOKIE_SECURE=false
ENCRYPTION_KEY=change-me-use-a-kms-managed-key-in-production
CREDENTIAL_SECRET=change-me-with-at-least-32-random-characters
ALLOW_LIVE_PUBLISH=false
SIGNED_URL_TTL_SECONDS=900
UPLOAD_MAX_BYTES=524288000
MEDIA_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
DELETION_GRACE_DAYS=7

# Limites e orçamento
MAX_VIDEO_MINUTES=10
MONTHLY_BUDGET_USD=100
MAX_COST_PER_VIDEO_USD=5
DEFAULT_BUDGET_USD_PER_MINUTE=0.35

# Render local: voz Kokoro padrão (pf_dora, pm_alex, pm_santa) e memória do worker
KOKORO_VOICE=pf_dora
RENDER_MAX_ATTEMPTS=3
WORKER_MEMORY_LIMIT=3g

# IA (Azure OpenAI). Sem estas chaves, pesquisa, roteiro e revisão usam a lógica local.
# Endpoint é só a base: de https://host/openai/deployments/<deployment>/chat/completions?api-version=<v>
# use AZURE_OPENAI_ENDPOINT=https://host, AZURE_OPENAI_CHAT_DEPLOYMENT=<deployment>, AZURE_OPENAI_API_VERSION=<v>.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Modelos de raciocínio (GPT-5, o-series): true. Para GPT-4o/4.1, false.
AZURE_OPENAI_REASONING=true
# Teto mínimo de tokens de saída por chamada (o raciocínio consome parte dele)
AZURE_OPENAI_MIN_COMPLETION_TOKENS=16000
# minimal | low | medium | high (vazio = padrão do modelo)
AZURE_OPENAI_REASONING_EFFORT=low
AZURE_OPENAI_TIMEOUT_SECONDS=300
# Preço do seu contrato, em centavos por milhão de tokens / por minuto transcrito (entra no orçamento)
AZURE_INPUT_CENTS_PER_MTOK=250
AZURE_OUTPUT_CENTS_PER_MTOK=1000
AZURE_TRANSCRIBE_CENTS_PER_MINUTE=1

# Pesquisa automática (artigos e vídeos de referência)
TAVILY_API_KEY=
YOUTUBE_API_KEY=
RESEARCH_ARTICLE_COUNT=5
RESEARCH_VIDEO_COUNT=6

# Mídia licenciada (Wikimedia Commons e Openverse funcionam sem chave)
# Contato (URL ou e-mail) no User-Agent do robô de mídia; o Wikimedia bloqueia robôs anônimos
MEDIA_CONTACT=
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Trechos curtos de vídeos de terceiros com crédito (uso transformativo; veja docs/AUTOMACAO.md)
FAIR_USE_CLIPS_ENABLED=false
FAIR_USE_MAX_CLIP_SECONDS=8
FAIR_USE_MAX_RATIO=0.2

# Piloto automático: valor inicial para organizações novas
AUTOPILOT_DEFAULT_ENABLED=false

# Publicação (OAuth)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
