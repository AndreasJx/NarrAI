FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg espeak-ng fonts-dejavu-core curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG KOKORO_MODEL_URL=https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.onnx
ARG KOKORO_VOICES_URL=https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin
RUN mkdir -p /models \
    && curl -fsSL --retry 5 -o /models/kokoro-v1.0.onnx "$KOKORO_MODEL_URL" \
    && curl -fsSL --retry 5 -o /models/voices-v1.0.bin "$KOKORO_VOICES_URL" \
    && chmod 0644 /models/*

WORKDIR /workspace
COPY apps/api/requirements.txt /tmp/requirements.txt
COPY packages/contracts /workspace/packages/contracts
COPY workers/pipeline /workspace/workers/pipeline
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && pip install --no-cache-dir /workspace/packages/contracts "/workspace/workers/pipeline[tts]"

COPY apps/api /workspace/apps/api
RUN useradd --create-home --uid 10001 app \
    && mkdir -p /workspace/artifacts \
    && chown -R app:app /workspace

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/apps/api \
    ARTIFACT_DIR=/workspace/artifacts \
    KOKORO_MODEL_PATH=/models/kokoro-v1.0.onnx \
    KOKORO_VOICES_PATH=/models/voices-v1.0.bin

USER app
CMD ["video-ai-worker"]
